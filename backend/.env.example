DATABASE_URL=postgresql+psycopg://tutoros:tutoros@localhost:5432/tutoros
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO

# Required for AI features (question generation, PDF extraction, performance
# insights) -- leave unset in dev if you don't need them, the rest of the app
# works fine without it.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# File storage backend: "local" (default, writes to UPLOAD_DIR) or "s3" (any
# S3-compatible endpoint -- MinIO via docker-compose.yml in dev, real AWS
# S3/R2 in prod; leave S3_ENDPOINT_URL unset for real AWS).
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=tutoros
# S3_SECRET_KEY=tutoros123
# S3_BUCKET=tutoros-uploads
# S3_REGION=us-east-1
